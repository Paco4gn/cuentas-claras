rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function signedEmail() {
      return request.auth.token.email;
    }

    function canReadGroupData(groupId) {
      return request.auth != null
        && signedEmail() in get(/databases/$(database)/documents/groups/$(groupId)).data.memberEmails;
    }

    function validPerson(userId) {
      return request.resource.data.userId == userId
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0;
    }

    function validRecord(userId) {
      return request.resource.data.userId == userId
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.amount is number
        && request.resource.data.amount > 0
        && request.resource.data.currency == 'EUR'
        && request.resource.data.kind in ['split', 'debt', 'payment']
        && request.resource.data.status in ['por-pagar', 'parcial', 'pagado'];
    }

    match /users/{userId} {
      allow read, delete: if isOwner(userId);
      allow create, update: if isOwner(userId);

      match /persons/{personId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId) && validPerson(userId);
      }

      match /records/{recordId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId) && validRecord(userId);
      }
    }

    match /groups/{groupId} {
      allow read: if request.auth != null && signedEmail() in resource.data.memberEmails;
      allow create: if request.auth != null
        && request.resource.data.ownerId == request.auth.uid
        && signedEmail() in request.resource.data.memberEmails;
      allow update: if request.auth != null
        && signedEmail() in resource.data.memberEmails
        && signedEmail() in request.resource.data.memberEmails
        && request.resource.data.ownerId == resource.data.ownerId;
      allow delete: if request.auth != null && resource.data.ownerId == request.auth.uid;

      match /persons/{personId} {
        allow read, delete: if canReadGroupData(groupId);
        allow create, update: if canReadGroupData(groupId) && validPerson(groupId);
      }

      match /records/{recordId} {
        allow read, delete: if canReadGroupData(groupId);
        allow create, update: if canReadGroupData(groupId) && validRecord(groupId);
      }
    }
  }
}
